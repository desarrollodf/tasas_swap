  "F099.DER.STO.Z.40.R.42.NET.Z.MMUSD.MLME.Z.Z.0.D",
  "F099.DER.STO.Z.40.R.55A.NET.Z.MMUSD.MLME.Z.Z.0.D",
  "F099.DER.STO.Z.40.R.44.NET.Z.MMUSD.MLME.Z.Z.0.D",
  "F099.DER.STO.Z.40.R.39.NET.Z.MMUSD.MLME.Z.Z.0.D",
  "F099.DER.STO.Z.40.R.38.NET.Z.MMUSD.MLME.Z.Z.0.D",
  "F099.DER.STO.Z.40.R.50.NET.Z.MMUSD.MLME.Z.Z.0.D",
  "F099.DER.STO.Z.40.N.NR.NET.Z.MMUSD.MLME.Z.Z.0.D"
)
colores_posnet <- c("#FF6F61", "#FFD166", "#66BFBF", "#6B4226", "#957DAD", "#54A24B", "#C51605")
codigos_posnet <- c(
  "AFP" = "afp",
  "Sector real" = "real",
  "Aseguradoras" = "segur",
  "Corredoras" = "corr",
  "AGF" = "agf",
  "Otros" = "otros",
  "No residentes" = "nores"
)

if (FALSE) {
  source("setup.R")
  posnet <- get(series_posnet, codigos_posnet) %>%
    na.omit(posnet) %>%
    group_by(code) %>%
    mutate(cambio = value - lag(value)) %>%
    ungroup()
  posnet_resnb_sum <- posnet %>%
    filter(code != "nores") %>%
    group_by(date) %>%
    summarise(value = sum(value)) %>%
    mutate(
      code = "resnb",
      cambio = value - lag(value)
    )
  posnet <- bind_rows(posnet, posnet_resnb_sum)
  posnet_total_sum <- posnet %>%
    filter(code %in% c("resnb", "nores")) %>%
    group_by(date) %>%
    summarise(value = sum(value)) %>%
    mutate(
      code = "posnet",
      cambio = value - lag(value)
    )
  posnet <- bind_rows(posnet, posnet_total_sum)
  write_xlsx(posnet, "posnet.xlsx")
}

posnet <- read_xlsx("posnet.xlsx") %>%
  mutate(
    code = factor(code, levels = codigos_posnet, labels = names(codigos_posnet)),
    tooltip = paste0(
      code, "<br>",
      "Valor: ", prettyNum(round(value), big.mark = ".", decimal.mark = ","), "<br>",
      "Fecha: ", format(date, "%m-%Y")
    )
  )

