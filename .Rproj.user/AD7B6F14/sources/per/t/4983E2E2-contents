server <- function(input, output, session) {
  
  output$grafico <- renderPlotly({
    
    grafico <- posnet %>%
      filter(code == names(codigos_posnet[7])) %>%
      ggplot(aes(x = date, y = value, color = code)) +
      theme_minimal() +
      geom_hline(yintercept = 0, alpha = 0.1, linewidth = 1) +
      geom_line(linewidth = 0.8) +
      geom_point(aes(text = tooltip), alpha = 0) +
      scale_color_manual(
        values = colores_posnet[7], name = NULL
      ) +
      labs(x = NULL, y = "Millones de dólares (US$)") +
      scale_y_continuous(
        labels = label_number(big.mark = ".", decimal.mark = ",")
      ) +
      theme(
        panel.background = element_rect(fill = "transparent", color = NA),
        plot.background = element_rect(fill = "transparent", color = NA),
        axis.title.y = element_text(size = 8)
      )
    
    # Convertir a plotly
    
    ggplotly(grafico, tooltip = "text") %>%
      plotly::layout(
        dragmode = FALSE,
        legend = list(
          orientation = "h",
          x = 0,
          y = 1.2,
          xanchor = "left",
          font = list(size = 9),
          tracegroupgap = 0,
          itemsizing = "constant"
        )
      ) %>%
      plotly::config(
        displayModeBar = FALSE,
        showTips = FALSE,
        scrollZoom = FALSE,
        doubleClick = FALSE,
        staticPlot = FALSE,
        displaylogo = FALSE,
        responsive = TRUE
        )
    
  })
}

shinyApp(ui, server)
